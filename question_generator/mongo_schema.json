{
  "collection": "questions",
  "fields": {
    "question_uid": {"type": "uuid"},
    "branch": {"type": "string"},
    "subject": {"type": "string"},
    "topic": {"type": "string"},
    "qtype": {"type": "string"},
    "difficulty": {"type": "string"},
    "statement": {"type": "string"},
    "options": {"type": "array"},
    "correct_answer": {"type": "string"},
    "explanation": {"type": "string"},
    "tags": {"type": "array"},
    "estimated_time": {"type": "int"},
    "marks": {"type": "int"},
    "provenance": {"type": "object"}
  },
  "indexes": [
    {"fields": ["branch", "subject", "qtype", "difficulty"]},
    {"fields": ["tags"], "type": "multikey"},
    {"fields": ["statement"], "type": "text"}
  ]
}
